{
 "kind": "control",
 "name": "buck_vmode",
 "title": "Buck 电压模式单环：Type III 补偿、PWM 增益、功率级、分压反馈",
 "profile": "ieee-double",
 "blocks": [
  {"id": "ref", "type": "tag", "style": "ref", "at": [0.75, 0], "size": [1.0, 0.5], "text": "$V_{\\mathrm{ref}}$"},
  {"id": "e1", "type": "sum", "at": [2.0, 0], "signs": {"w": "+", "s": "-"}},
  {"id": "gc", "type": "block", "at": [3.7, 0], "size": [1.4, 0.8], "text": "$G_{c}(s)$", "label": "Type III", "label_pos": "above"},
  {"id": "pwm", "type": "block", "at": [5.8, 0], "size": [1.0, 0.8], "text": "$\\frac{1}{V_{M}}$", "label": "PWM", "label_pos": "above"},
  {"id": "plant", "type": "block", "at": [8.1, 0], "size": [1.6, 0.8], "text": "$G_{vd}(s)$", "label": "Buck power stage", "label_pos": "above"},
  {"id": "h", "type": "block", "at": [5.8, -1.3], "size": [1.0, 0.6], "text": "$H$", "label": "Divider", "label_pos": "below"}
 ],
 "links": [
  {"from": "ref.e", "to": "e1.w"},
  {"from": "e1.e", "to": "gc.w", "label": "$v_{e}$"},
  {"from": "gc.e", "to": "pwm.w", "label": "$v_{c}$"},
  {"from": "pwm.e", "to": "plant.w", "label": "$d$"},
  {"from": "plant.e", "to": [10.6, 0], "open": true},
  {"from": [9.6, 0], "via": [[9.6, -1.3]], "to": "h.e"},
  {"from": "h.w", "via": [[2.0, -1.3]], "to": "e1.s"}
 ],
 "texts": [
  {"at": [10.68, 0], "text": "$v_{o}$", "anchor": "west"}
 ],
 "regions": [
  {"from": [-0.1, -2.15], "to": [11.3, 1.35], "fill": "green", "label": "Voltage-mode buck loop", "label_pos": "inside"}
 ],
 "loop": {
  "params": {"Vin": 12, "Vo": 3.3, "Vref": 1.65, "L": 10e-6, "C": 100e-6, "ESR": 0.02,
             "Rload": 1.0, "VM": 1.5},
  "tf": {
   "gc": {"comp": {"fi": 14500, "fz": [7250, 7250], "fp": [124000, 124000]}},
   "pwm": {"gain": "1/VM"},
   "plant": {"model": "buck", "vin": "Vin", "l": "L", "c": "C", "r": "Rload", "rc": "ESR"},
   "h": {"gain": "Vref/Vo"}
  },
  "breaks": [{"at": "pwm", "label": "$T(s)$"}],
  "closed": [{"from": "ref", "to": "plant", "label": "$v_{o}/V_{\\mathrm{ref}}$"}],
  "freq": [10, 1e6]
 },
 "code": {
  "fs": 300e3, "method": "tustin", "arith": "fixed", "q": 24,
  "external": ["plant"],
  "blocks": {"gc": {"min": 0, "max": "VM"}, "pwm": {"min": 0, "max": 0.95}}
 }
}
