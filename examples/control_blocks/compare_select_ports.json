{
  "kind": "control",
  "name": "compare_select_ports",
  "title": "Comparator flag F_s drives the select input of an A/B switch; a tall block labels its ports",
  "blocks": [
    {"id": "vpcc", "type": "tag", "style": "meas", "at": [-0.1, 1.9], "size": [1.3, 0.5], "text": "$V_{PCC}$"},
    {"id": "vth", "type": "tag", "style": "plain", "at": [-0.1, 1.3], "size": [1.3, 0.5], "text": "0.5 p.u."},
    {"id": "cmp", "type": "compare", "point": "e", "at": [1.9, 1.6], "size": [1.2, 1.2], "text": "$<$",
     "port_labels": {"w+0.3": "$+$", "w-0.3": "$-$"}},
    {"id": "sw", "type": "switch", "pole": [5.0, 0.0], "throws": {"A": [4.0, 0.4], "B": [4.0, -0.4]}, "on": "A", "select": true},
    {"id": "eq", "type": "block", "at": [7.0, 0.0], "size": [1.0, 2.4], "fill": "yellow",
     "port_labels": {"w+0.8": "(9)", "w": "(10)", "w-0.8": "(16)"}}
  ],
  "links": [
    {"from": "vpcc.e", "to": "cmp.w+0.3"},
    {"from": "vth.e", "to": "cmp.w-0.3"},
    {"from": "cmp.e", "via": [[4.5, 1.6]], "to": "sw.sel", "label": "$F_s$", "label_pos": "right", "label_at": 0.75},
    {"from": [4.0, 1.1], "to": "sw.A", "open": true, "label": "$i_{ref,1}$", "label_pos": "left", "label_at": 0.0},
    {"from": [4.0, -1.1], "to": "sw.B", "open": true, "label": "$i_{ref,2}$", "label_pos": "left", "label_at": 0.0},
    {"from": "sw.c", "to": "eq.w"},
    {"from": [5.6, 0.8], "to": "eq.w+0.8", "open": true},
    {"from": [5.6, -0.8], "to": "eq.w-0.8", "open": true},
    {"from": "eq.e", "to": [8.4, 0.0], "open": true}
  ]
}
