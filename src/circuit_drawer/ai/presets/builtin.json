[
  {
    "id": "buck_voltage",
    "title": {
      "zh-CN": "Buck 电压单环",
      "en": "Buck voltage loop",
      "zh-TW": "Buck 電壓單環"
    },
    "mode": "create",
    "domains": [
      "circuit",
      "control"
    ],
    "body": "Buck 降压电路及电压负反馈：参考→误差→PI→占空比限幅→PWM→功率级，输出电压反馈至误差负端。",
    "fields": [
      {
        "key": "vin",
        "label": {
          "zh-CN": "输入电压",
          "en": "Input voltage",
          "zh-TW": "輸入電壓"
        },
        "unit": "V",
        "required": true
      },
      {
        "key": "vout",
        "label": {
          "zh-CN": "目标输出电压",
          "en": "Target output voltage",
          "zh-TW": "目標輸出電壓"
        },
        "unit": "V",
        "required": true
      },
      {
        "key": "frequency",
        "label": {
          "zh-CN": "开关频率",
          "en": "Switching frequency",
          "zh-TW": "開關頻率"
        },
        "unit": "Hz",
        "required": true
      },
      {
        "key": "inductance",
        "label": {
          "zh-CN": "电感",
          "en": "Inductance",
          "zh-TW": "電感"
        },
        "unit": "H",
        "required": true
      },
      {
        "key": "capacitance",
        "label": {
          "zh-CN": "输出电容",
          "en": "Output capacitance",
          "zh-TW": "輸出電容"
        },
        "unit": "F",
        "required": true
      },
      {
        "key": "load",
        "label": {
          "zh-CN": "负载电阻",
          "en": "Load resistance",
          "zh-TW": "負載電阻"
        },
        "unit": "Ω",
        "required": true
      },
      {
        "key": "kp",
        "label": {
          "zh-CN": "比例增益",
          "en": "Proportional gain",
          "zh-TW": "比例增益"
        },
        "unit": "",
        "required": true
      },
      {
        "key": "ki",
        "label": {
          "zh-CN": "积分增益",
          "en": "Integral gain",
          "zh-TW": "積分增益"
        },
        "unit": "1/s",
        "required": true
      }
    ],
    "capability": {
      "zh-CN": "可生成符号图。数值分析和原生导出需补齐参数、绑定并通过相应校验；不保证控制器已整定。",
      "en": "Symbolic drawing is available. Numeric analysis and native export require complete parameters, bindings and validation; controllers are not automatically tuned.",
      "zh-TW": "可生成符號圖。數值分析與原生匯出需補齊參數、綁定並通過對應校驗；不保證控制器已整定。"
    }
  },
