  "aliases": [
   "single phase half bridge inverter",
   "单相半桥逆变器"
  ],
  "description": "Resistive-load square-wave example. Inductive-load commutation and sinusoidal PWM require different modes.",
  "default_profile": "ieee-double",
  "references": [
   "https://www.monolithicpower.com/en/learning/mpscholar/power-electronics/dc-ac-converters/single-phase-inverters"
  ]
 },
