  ],
  "annotations": [],
  "netlist": {
   "Vin.a": "DCN",
   "Vin.b": "DCP",
   "C1.a": "DCP",
   "C1.b": "MID",
   "C2.a": "MID",
   "C2.b": "DCN",
   "S1.d": "DCP",
   "S1.s": "A",
   "S2.d": "A",
