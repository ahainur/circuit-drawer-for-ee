    "pins": {
     "a": [
      0.0,
      0.0
     ],
     "b": [
      0.0,
      4.0
     ]
    },
    "label": "$V_{dc}$",
    "label_pos": "left"
   },
   {
    "id": "C1",
    "kind": "C",
    "pins": {
     "a": [
      1.5,
      4.0
     ],
     "b": [
      1.5,
      2.6
     ]
    },
    "label": "$C_1$",
    "label_pos": "left"
   },
   {
    "id": "C2",
